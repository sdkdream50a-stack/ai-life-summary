{
  "name": "ai-life-summary",
  "version": "1.0.0",
  "description": "AI Life Summary - deterministic birthday-hash entertainment generator",
  "scripts": {
    "build:blog": "node scripts/build-blog.js",
    "new:post": "node scripts/new-post.js",
    "build:css": "npx @tailwindcss/cli -i ./css/input.css -o ./css/tailwind.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./css/input.css -o ./css/tailwind.css --watch",
    "build:i18n": "node scripts/build-i18n-pages.js",
    "build:legal": "node scripts/build-legal-i18n.js",
    "build:sitemap": "node scripts/generate-sitemap.js",
    "build:adsense-boundary": "node scripts/enforce-adsense-boundary.js",
    "check:adsense-boundary": "node scripts/enforce-adsense-boundary.js --check",
    "build:asset-version": "node scripts/stamp-asset-version.js",
    "check:asset-version": "node scripts/stamp-asset-version.js --check",
    "build:all": "npm run build:i18n && npm run build:legal && npm run build:shared-entry && npm run build:sitemap && npm run build:asset-version && npm run build:adsense-boundary",
    "danger:redirectors": "node scripts/create-redirectors.js",
    "check:s1-guards": "node scripts/check-s1-guards.js",
    "check:s2-home": "node scripts/check-s2-home.js",
    "verify": "npm run build:all && npm run check:adsense-boundary && npm run check:asset-version && npm run check:s1-guards && npm run check:s2-home && npm run check:pre-s3-hardening && npm run check:telemetry-consent && npm run check:age-calculator && npm run check:viral-results && npm run check:shared-entry",
    "check:pre-s3-hardening": "node scripts/check-pre-s3-hardening.js",
    "check:telemetry-consent": "node scripts/check-telemetry-consent.js",
    "check:age-calculator": "node scripts/check-age-calculator-funnel.js",
    "check:viral-results": "node scripts/check-viral-result-surfaces.js",
    "build:shared-entry": "node scripts/build-shared-entry.js",
    "check:shared-entry": "node scripts/build-shared-entry.js --check"
  },
  "author": "AI Life Summary",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18"
  }
}
