{
  "name": "ai-life-summary",
  "version": "1.0.0",
  "description": "AI Life Summary - AI-powered life summary generator",
  "scripts": {
    "generate": "node scripts/generate-post.js",
    "preview:schedule": "node scripts/preview-schedule.js",
    "build:blog": "node scripts/build-blog.js",
    "new:post": "node scripts/new-post.js",
    "build:css": "npx @tailwindcss/cli -i ./css/input.css -o ./css/tailwind.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./css/input.css -o ./css/tailwind.css --watch",
    "build:i18n": "node scripts/build-i18n-pages.js",
    "build:sitemap": "node scripts/generate-sitemap.js",
    "build:redirectors": "node scripts/create-redirectors.js",
    "build:all": "npm run build:i18n && npm run build:redirectors && npm run build:sitemap && npm run build:ads",
    "build:ads": "node scripts/update-ad-placements.js"
  },
  "author": "AI Life Summary",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18"
  }
}
